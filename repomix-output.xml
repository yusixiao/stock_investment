def _make_yjbb_df(quarter="20241231", n=3):
    codes = ["000001", "600000", "300001"][:n]
    names = ["平安银行", "浦发银行", "特锐德"][:n]
    rows = []
    for i, (code, name) in enumerate(zip(codes, names)):
        rows.append({
            "序号": i + 1,
            "股票代码": code,
            "股票简称": name,
            "每股收益": 1.5 + i * 0.1,
            "营业总收入-营业总收入": 1e10 + i * 1e9,
